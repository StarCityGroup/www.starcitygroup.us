---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { projects } from './projects/projects';
import Banner from '@src/assets/img/lisheng-chang-M2524ncJQ40-unsplash.jpg';
import Anthony from '@src/assets/img/anthonytownsend.png';
import GhostRoadCover from '/public/images/ghostroad-cover.png';
import SmartCitiesCover from '/public/images/smartcities-cover-full.jpg';

type BlogPost = CollectionEntry<'blog'>;

// Get recent posts
const allPosts = (await getCollection('blog')).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentWork = allPosts.slice(0, 6);
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} isHomePage={true}>
	<style is:global>
		html body {
			padding-top: 0 !important;
		}

		.hero-container {
			min-height: 85vh;
			display: flex;
			align-items: center;
		}

		.hero-content {
			max-width: 900px;
		}

		.hero-title {
			font-size: 3.5rem;
			font-weight: 800;
			line-height: 1.1;
			margin-bottom: 1.5rem;
			color: white;
			text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
		}

		@media (min-width: 768px) {
			.hero-title {
				font-size: 5rem;
			}
		}

		.hero-subtitle {
			font-size: 1.5rem;
			line-height: 1.6;
			color: rgba(255, 255, 255, 0.95);
			font-weight: 400;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.2);
		}

		.section-title {
			font-size: 2.5rem;
			font-weight: 700;
			margin-bottom: 2rem;
			color: #111;
		}

		.dark .section-title {
			color: #fff;
		}

		.book-card {
			transition: transform 0.3s ease, box-shadow 0.3s ease;
			border-radius: 12px;
			overflow: hidden;
		}

		.book-card:hover {
			transform: translateY(-8px);
			box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
		}

		.book-cover {
			width: 100%;
			height: auto;
			border-radius: 8px;
			box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
		}

		.work-item {
			transition: all 0.2s ease;
		}

		.work-item:hover {
			transform: translateX(4px);
		}

		.content-section {
			padding: 5rem 0;
		}

		@media (max-width: 768px) {
			.content-section {
				padding: 3rem 0;
			}
			.hero-title {
				font-size: 2.5rem;
			}
			.hero-subtitle {
				font-size: 1.25rem;
			}
			.section-title {
				font-size: 2rem;
			}
		}

		.author-intro {
			background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(168, 85, 247, 0.05) 100%);
			border-radius: 16px;
			padding: 3rem;
		}

		.dark .author-intro {
			background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(168, 85, 247, 0.1) 100%);
		}
	</style>

	<!-- Hero Section -->
	<div class="relative">
		<div class="absolute inset-0 z-0">
			<img
				src={Banner.src}
				alt="Banner"
				class="w-full h-full object-cover"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-black/60"></div>
		</div>

		<div class="relative z-10 hero-container">
			<div class='container px-4 mx-auto max-w-6xl'>
				<div class="hero-content">
					<h1 class="hero-title">Anthony M. Townsend</h1>
					<p class="hero-subtitle">
						Author, urbanist, and researcher exploring the future of cities and technology
					</p>
				</div>
			</div>
		</div>
	</div>

	<!-- Books Section -->
	<div class="content-section bg-white dark:bg-zinc-900">
		<div class='container px-4 mx-auto max-w-6xl'>
			<h2 class="section-title text-center mb-12">Books</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl mx-auto">
				<!-- Ghost Road -->
				<a href="/books/" class="book-card group">
					<img
						src={GhostRoadCover.src}
						alt="Ghost Road: Beyond the Driverless Car"
						class="book-cover"
					/>
					<div class="text-center mt-6">
						<h3 class="text-2xl font-bold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400">
							Ghost Road
						</h3>
						<p class="text-zinc-600 dark:text-zinc-400 mb-1">Beyond the Driverless Car</p>
						<p class="text-sm text-zinc-500 dark:text-zinc-500">W.W. Norton & Co., 2020</p>
					</div>
				</a>

				<!-- Smart Cities -->
				<a href="/books/" class="book-card group">
					<img
						src="/images/SmartCities_Cover.png"
						alt="Smart Cities: Big Data, Civic Hackers, and the Quest For A New Utopia"
						class="book-cover"
					/>
					<div class="text-center mt-6">
						<h3 class="text-2xl font-bold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400">
							Smart Cities
						</h3>
						<p class="text-zinc-600 dark:text-zinc-400 mb-1">Big Data, Civic Hackers, and the Quest For A New Utopia</p>
						<p class="text-sm text-zinc-500 dark:text-zinc-500">W.W. Norton & Co., 2013</p>
					</div>
				</a>
			</div>
		</div>
	</div>

	<!-- About Section -->
	<div class="content-section bg-zinc-50 dark:bg-zinc-800">
		<div class='container px-4 mx-auto max-w-6xl'>
			<div class="author-intro">
				<div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
					<div class="md:w-1/3">
						<Image
							src={Anthony}
							alt="Anthony Townsend"
							class="rounded-2xl shadow-xl w-full"
						/>
					</div>
					<div class="md:w-2/3">
						<h2 class="text-3xl font-bold mb-4">About Anthony</h2>
						<div class="space-y-4 text-lg text-zinc-700 dark:text-zinc-300">
							<p>
								Dr. Anthony Townsend is President and Founder of <strong>Star City Group</strong>, where he works around the world with industry, government, and philanthropy on urban tech foresight, policy, and planning studies.
							</p>
							<p>
								He is Senior Research Associate at Cornell Tech's Jacobs Urban Tech Hub, where he leads multi-disciplinary research collaborations connecting university researchers with stakeholders in industry, government, and civil society.
							</p>
							<p>
								Anthony's work has influenced global debates on technology and urbanism, with particular focus on transforming traditional approaches to creating more connected, livable, efficient, and equitable cities.
							</p>
							<div class="pt-4">
								<a href="/about/" class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors">
									Learn More
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Recent Work Section -->
	<div class="content-section bg-white dark:bg-zinc-900">
		<div class='container px-4 mx-auto max-w-6xl'>
			<div class="flex justify-between items-center mb-8">
				<h2 class="section-title mb-0">Recent Work</h2>
				<a href="/other-work/" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold">
					View all →
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{recentWork.map((post: BlogPost) => (
					<a
						href={`/${post.slug}/`}
						class="work-item p-6 rounded-lg border border-zinc-200 dark:border-zinc-700 hover:border-blue-400 dark:hover:border-blue-500 bg-white dark:bg-zinc-800"
					>
						<div class="text-sm text-zinc-500 dark:text-zinc-500 mb-2">
							{new Date(post.data.pubDate).toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric'
							})}
						</div>
						<h3 class="text-xl font-semibold mb-2 text-zinc-900 dark:text-zinc-100">
							{post.data.title}
						</h3>
						{post.data.description && (
							<p class="text-zinc-600 dark:text-zinc-400">
								{post.data.description}
							</p>
						)}
					</a>
				))}
			</div>
		</div>
	</div>
</BaseLayout>
