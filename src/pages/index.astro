---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Prose from '../components/Prose.astro';
import { projects } from './projects/projects';
import ProjectList from '../components/ProjectList.astro'
import PostItem from '../components/PostItem.astro';
import Banner from '@src/assets/img/lisheng-chang-M2524ncJQ40-unsplash.jpg';

type BlogPost = CollectionEntry<'blog'>;

const top6Projects = projects.slice(0, 6);
const posts = (await getCollection('blog')).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} isHomePage={true}>
	<style is:global>
		/* Target body on homepage with higher specificity */
		html body {
			padding-top: 0 !important;
		}
		.content-panel {
			background-color: rgba(255, 255, 255, 0.8);
			backdrop-filter: blur(8px);
			border-radius: 8px;
			padding: 24px;
		}
		.date-label {
			font-size: 0.875rem;
			color: #444;
			width: 100px;
			flex-shrink: 0;
		}
		.post-title {
			color: #111;
			font-weight: 500;
		}
		.header-row {
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-bottom: 1px solid rgba(0, 0, 0, 0.1);
			padding-bottom: 12px;
			margin-bottom: 16px;
		}
		.view-all {
			font-size: 0.875rem;
			color: #444;
			text-decoration: none;
		}
		.view-all:hover {
			text-decoration: underline;
		}
		.project-card {
			border-radius: 8px;
			overflow: hidden;
			display: flex;
			flex-direction: column;
		}
		.project-card img {
			width: 100%;
			height: 180px;
			object-fit: cover;
		}
	</style>
	<div class="relative min-h-screen">
		<!-- Full-screen banner image with overlay -->
		<div class="absolute inset-0 z-0">
			<img 
				src={Banner.src} 
				alt="Banner" 
				class="w-full h-full object-cover"
			/>
			<div class="absolute inset-0 bg-black bg-opacity-30"></div>
		</div>
		
		<!-- Floating content over the banner image -->
		<div class="relative z-10">
			<div class='container px-4 mx-auto max-w-6xl'>
				<section class='py-12 md:py-20'>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<!-- Hero Panel -->
						<div class="content-panel">
							<h1 class="text-4xl sm:text-5xl font-bold mb-4 text-black">We make sense of urban technologies.</h1>
							<p class="mb-2 text-gray-700">Rapid technological change can be terrifying.</p>
							<p class="text-gray-700">We work with government agencies, non-profits, and companies to make sense of emerging technologies and identify disruptions before they happen.</p>
						</div>

						<!-- Recent Posts Panel -->
						<div class="content-panel">
							<div class="header-row">
								<h2 class="text-xl font-semibold">Recent Posts</h2>
								<a href="/posts/" class="view-all">All posts »</a>
							</div>

							<div class="space-y-4">
								{
									posts.map((post: BlogPost) => (
										<div class="flex items-baseline">
											<div class="date-label">
												{new Date(post.data.pubDate).toLocaleDateString('en-US', {
													year: 'numeric',
													month: 'short', 
													day: '2-digit'
												})}
											</div>
											<a href={`/posts/${post.slug}/`} class="post-title hover:underline">{post.data.title}</a>
										</div>
									))
								}
							</div>
						</div>

						<!-- Projects Panel -->
						<div class="content-panel md:col-span-2">
							<div class="header-row">
								<h2 class="text-xl font-semibold">Projects</h2>
								<a href="/projects/" class="view-all">All projects »</a>
							</div>

							<p class="mb-4 text-sm text-gray-600">Explore some of our most impactful work. (Links open external sites).</p>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
								{top6Projects.slice(0, 3).map((project) => (
									<a href={project.url} class="project-card group">
										<div class="relative">
											{project.image && (
												<>
													<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
													<div class="absolute bottom-0 left-0 p-3 z-20">
														<span class="inline-block px-3 py-1 text-xs rounded bg-white/80 text-black font-medium">{project.date}</span>
													</div>
													<img
														src={project.image}
														alt={project.title}
													/>
												</>
											)}
										</div>
										<div class="p-3 bg-white/60">
											<h3 class="font-medium text-black group-hover:underline">{project.name}</h3>
											<p class="text-sm text-gray-700 mt-1">{project.description}</p>
										</div>
									</a>
								))}
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</div>
</BaseLayout>
