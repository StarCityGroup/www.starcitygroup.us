---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Banner from '@src/assets/img/lisheng-chang-M2524ncJQ40-unsplash.jpg';
import Anthony from '@src/assets/img/anthonytownsend.png';
import GhostRoadCover from '/public/images/ghostroad-cover.png';
import SmartCitiesCover from '/public/images/smartcities-cover-full.jpg';
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} isHomePage={true}>
	<style is:global>
		html body {
			padding-top: 0 !important;
		}

		.hero-container {
			min-height: 100vh;
			display: flex;
			align-items: flex-start;
			padding-top: 8rem;
		}

		.hero-content {
			max-width: 1000px;
		}

		.hero-title {
			font-size: 5rem;
			font-weight: 900;
			line-height: 0.95;
			margin-bottom: 2rem;
			color: white;
			text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
			letter-spacing: -0.02em;
		}

		@media (min-width: 768px) {
			.hero-title {
				font-size: 7rem;
			}
		}

		@media (min-width: 1024px) {
			.hero-title {
				font-size: 8.5rem;
			}
		}

		.hero-subtitle {
			font-size: 1.75rem;
			line-height: 1.5;
			color: rgba(255, 255, 255, 0.95);
			font-weight: 300;
			text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
			max-width: 700px;
		}

		@media (min-width: 768px) {
			.hero-subtitle {
				font-size: 2rem;
			}
		}

		.section-title {
			font-size: 2.5rem;
			font-weight: 700;
			margin-bottom: 2rem;
			color: #111;
		}

		.dark .section-title {
			color: #fff;
		}

		.section-heading {
			text-align: center;
		}

		.section-heading .eyebrow {
			text-transform: uppercase;
			letter-spacing: 0.2em;
			font-size: 0.85rem;
			font-weight: 600;
			color: #6366f1;
			margin-bottom: 1rem;
		}

		.dark .section-heading .eyebrow {
			color: #a5b4fc;
		}

		.book-card {
			transition: transform 0.3s ease, box-shadow 0.3s ease;
			border-radius: 12px;
			overflow: hidden;
		}

		.book-card:hover {
			transform: translateY(-8px);
			box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
		}

		.book-cover {
			width: 100%;
			height: auto;
			border-radius: 8px;
			box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
		}

		.work-item {
			transition: all 0.2s ease;
		}

		.work-item:hover {
			transform: translateX(4px);
		}

		.content-section {
			padding: 5rem 0;
		}

		.books-section,
		.bio-section {
			min-height: 100vh;
			padding: clamp(4rem, 8vw, 7rem) 0;
			position: relative;
			overflow: hidden;
		}

		.books-section {
			background: radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.15), transparent 55%), #f8fafc;
		}

		.dark .books-section {
			background: radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.3), transparent 55%), #020617;
		}

		.books-section-glow,
		.bio-section-glow {
			position: absolute;
			top: -20%;
			left: 50%;
			width: 800px;
			height: 800px;
			border-radius: 999px;
			filter: blur(120px);
			opacity: 0.3;
			transform: translateX(-50%);
			pointer-events: none;
		}

		.books-section-glow {
			background: rgba(14, 165, 233, 0.6);
		}

		.bio-section-glow {
			background: rgba(236, 72, 153, 0.4);
			bottom: -20%;
			top: auto;
		}

		.books-grid {
			display: flex;
			flex-direction: column;
			gap: clamp(2rem, 4vw, 3.5rem);
		}

		.book-panel {
			border-radius: 32px;
			border: 1px solid rgba(15, 23, 42, 0.08);
			padding: clamp(2rem, 4vw, 3rem);
			background: rgba(255, 255, 255, 0.9);
			box-shadow: 0 25px 80px rgba(15, 23, 42, 0.15);
			display: grid;
			gap: 2rem;
			align-items: center;
		}

		.dark .book-panel {
			background: rgba(15, 23, 42, 0.85);
			border-color: rgba(255, 255, 255, 0.05);
			box-shadow: 0 35px 80px rgba(0, 0, 0, 0.6);
		}

		@media (min-width: 768px) {
			.book-panel {
				grid-template-columns: 1fr 1.25fr;
			}
		}

		.book-cover-shell {
			border-radius: 28px;
			padding: 1.5rem;
			background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(236, 72, 153, 0.12));
		}

		.dark .book-cover-shell {
			background: linear-gradient(135deg, rgba(59, 130, 246, 0.25), rgba(236, 72, 153, 0.25));
		}

		.book-cover-image {
			border-radius: 18px;
			box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
		}

		.book-pill {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			font-size: 0.85rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			background: rgba(15, 23, 42, 0.06);
			color: #0f172a;
			padding: 0.4rem 0.85rem;
			border-radius: 999px;
		}

		.dark .book-pill {
			background: rgba(248, 250, 252, 0.15);
			color: #f8fafc;
		}

		.book-title {
			font-size: clamp(1.75rem, 2.5vw, 2.75rem);
			font-weight: 800;
			margin: 1rem 0;
			color: inherit;
		}

		.book-quote {
			font-style: italic;
			color: rgba(15, 23, 42, 0.8);
		}

		.book-quote-source {
			font-size: 0.9rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			margin-bottom: 1.5rem;
			color: rgba(15, 23, 42, 0.6);
		}

		.dark .book-quote,
		.dark .book-quote-source {
			color: rgba(248, 250, 252, 0.8);
		}

		.book-summary {
			font-size: 1.05rem;
			line-height: 1.7;
			color: rgba(15, 23, 42, 0.9);
			margin-bottom: 1.5rem;
		}

		.dark .book-summary {
			color: rgba(248, 250, 252, 0.85);
		}

		.book-links {
			display: flex;
			flex-wrap: wrap;
			gap: 0.85rem;
		}

		.book-link {
			padding: 0.85rem 1.5rem;
			border-radius: 999px;
			font-weight: 600;
			transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
			border: 1px solid transparent;
		}

		.book-link.primary {
			background: #0f172a;
			color: #f8fafc;
		}

		.dark .book-link.primary {
			background: #f8fafc;
			color: #0f172a;
		}

		.book-link.secondary {
			border-color: rgba(15, 23, 42, 0.15);
			color: #0f172a;
			background: transparent;
		}

		.dark .book-link.secondary {
			border-color: rgba(248, 250, 252, 0.4);
			color: #f8fafc;
		}

		.book-link:hover {
			transform: translateY(-2px);
		}

		.bio-section {
			background: radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.12), transparent 55%), #faf5ff;
		}

		.dark .bio-section {
			background: radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.25), transparent 55%), #0b1120;
		}

		.bio-shell {
			border-radius: 40px;
			border: 1px solid rgba(15, 23, 42, 0.08);
			background: rgba(255, 255, 255, 0.9);
			box-shadow: 0 35px 90px rgba(15, 23, 42, 0.12);
			padding: clamp(2rem, 5vw, 4rem);
			display: grid;
			gap: 2.5rem;
		}

		.dark .bio-shell {
			background: rgba(2, 6, 23, 0.9);
			border-color: rgba(255, 255, 255, 0.06);
			box-shadow: 0 45px 100px rgba(0, 0, 0, 0.6);
		}

		@media (min-width: 900px) {
			.bio-shell {
				grid-template-columns: 1fr 1.2fr;
				align-items: center;
			}
		}

		.bio-portrait-frame {
			position: relative;
			border-radius: 32px;
			padding: 1.5rem;
			background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(236, 72, 153, 0.25));
		}

		.bio-content .eyebrow {
			text-transform: uppercase;
			letter-spacing: 0.2em;
			font-size: 0.9rem;
			font-weight: 600;
			color: #ec4899;
			margin-bottom: 1rem;
		}

		.dark .bio-content .eyebrow {
			color: #f472b6;
		}

		.bio-content h2 {
			font-size: clamp(2rem, 3vw, 3.5rem);
			font-weight: 800;
			margin-bottom: 1.5rem;
		}

		.bio-copy {
			font-size: 1.1rem;
			line-height: 1.75;
			color: rgba(15, 23, 42, 0.85);
			margin-bottom: 1rem;
		}

		.dark .bio-copy {
			color: rgba(248, 250, 252, 0.8);
		}

		.bio-cta {
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
		}

		.bio-cta a {
			padding: 0.95rem 1.75rem;
			border-radius: 999px;
			font-weight: 600;
			border: 1px solid transparent;
		}

		.bio-cta a.primary {
			background: #0f172a;
			color: #fff;
		}

		.dark .bio-cta a.primary {
			background: #f8fafc;
			color: #0f172a;
		}

		.bio-cta a.secondary {
			border-color: rgba(15, 23, 42, 0.15);
			color: #0f172a;
		}

		.dark .bio-cta a.secondary {
			border-color: rgba(248, 250, 252, 0.4);
			color: #f8fafc;
		}

		@media (max-width: 768px) {
			.content-section {
				padding: 3rem 0;
			}
			.hero-container {
				padding-top: 6rem;
			}
			.hero-title {
				font-size: 3.5rem;
			}
			.hero-subtitle {
				font-size: 1.4rem;
			}
			.section-title {
				font-size: 2rem;
			}
		}

	</style>

	<!-- Hero Section -->
	<div class="relative">
		<div class="absolute inset-0 z-0">
			<img
				src={Banner.src}
				alt="Banner"
				class="w-full h-full object-cover"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-black/60"></div>
		</div>

		<div class="relative z-10 hero-container">
			<div class='container px-4 mx-auto max-w-6xl'>
				<div class="hero-content">
					<h1 class="hero-title">Anthony M. Townsend</h1>
					<p class="hero-subtitle">
						Author, urbanist, and researcher exploring the future of cities and technology
					</p>
					<div class="flex gap-4 mt-6">
						<a href="https://www.linkedin.com/in/anthonytownsendnyc/" target="_blank" rel="noopener noreferrer" class="p-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-full transition-all hover:scale-110" aria-label="LinkedIn">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white" stroke="none">
								<path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 00.1.47V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path>
							</svg>
						</a>
						<a href="https://github.com/anthonymobile" target="_blank" rel="noopener noreferrer" class="p-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-full transition-all hover:scale-110" aria-label="GitHub">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white" stroke="none">
								<path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.841-2.337 4.687-4.565 4.934.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.16 22 16.416 22 12c0-5.523-4.477-10-10-10z"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Books Section -->
	<section class="content-section books-section relative overflow-hidden">
		<div class="books-section-glow" aria-hidden="true"></div>
		<div class='container px-4 mx-auto max-w-6xl relative z-10'>
			<div class="section-heading max-w-3xl mx-auto mb-16">
				<p class="eyebrow">Books</p>
				<h2 class="section-title mb-4">Ideas meant to be dog-eared</h2>
				<p class="text-lg text-zinc-700 dark:text-zinc-300">
					Longform investigations at the intersection of urbanism, emerging technology, and policy—written for readers who want to understand what comes next for cities.
				</p>
			</div>

			<div class="books-grid">
				<article class="book-panel">
					<div class="book-cover-shell">
						<Image
							src={GhostRoadCover}
							alt="Ghost Road book cover"
							class="book-cover-image w-full"
						/>
					</div>
					<div>
						<p class="book-pill">Future Mobility</p>
						<h3 class="book-title">Ghost Road: Beyond the Driverless Car</h3>
						<p class="book-quote">"Ghost Road offers up an exhilarating picture of the ways in which autonomous vehicles might transform our lives for the better."</p>
						<p class="book-quote-source">— James Surowiecki, Strategy + Business</p>
						<p class="book-summary">
							When autonomy escapes the car and infects transit networks, delivery fleets, and buildings themselves, the map of daily life shifts dramatically. Ghost Road lays out the design choices and policy trade-offs we face as cities navigate that transition.
						</p>
						<div class="book-links">
							<a href="https://bookshop.org/books/ghost-road-beyond-the-driverless-car-9781684579341/9781324001522" target="_blank" rel="noopener noreferrer" class="book-link primary">Bookshop.org</a>
							<a href="https://www.wordbookstores.com/book/9781324001522" target="_blank" rel="noopener noreferrer" class="book-link secondary">WORD Bookstores</a>
							<a href="https://www.amazon.com/Ghost-Road-Anthony-M-Townsend/dp/1324001526" target="_blank" rel="noopener noreferrer" class="book-link secondary">Amazon</a>
							<a href="https://www.porchlightbooks.com/products/ghost-road-anthony-m-townsend-9781324001522?_pos=1&_sid=fc547e3ca&_ss=r" target="_blank" rel="noopener noreferrer" class="book-link secondary">Bulk Orders</a>
						</div>
					</div>
				</article>

				<article class="book-panel">
					<div class="book-cover-shell">
						<Image
							src={SmartCitiesCover}
							alt="Smart Cities book cover"
							class="book-cover-image w-full"
						/>
					</div>
					<div>
						<p class="book-pill">Urban Futures</p>
						<h3 class="book-title">Smart Cities: Big Data, Civic Hackers, and the Quest for a New Utopia</h3>
						<p class="book-quote">"A timely and necessary guide to this age of the Franken-city."</p>
						<p class="book-quote-source">— Daniel Brook, The New York Times Book Review</p>
						<p class="book-summary">
							A global tour of how technologists, public servants, and civic hackers are wiring the metropolis—and what happens when code collides with people. Smart Cities unpacks who benefits, who is left behind, and how we can design urban tech for everyone.
						</p>
						<div class="book-links">
							<a href="https://bookshop.org/books/smart-cities-big-data-civic-hackers-and-the-quest-for-a-new-utopia/9780393349788" target="_blank" rel="noopener noreferrer" class="book-link primary">Bookshop.org</a>
							<a href="https://www.wordbookstores.com/book/9780393349788" target="_blank" rel="noopener noreferrer" class="book-link secondary">WORD Bookstores</a>
							<a href="https://www.amazon.com/dp/0393349780/ref=cm_sw_su_dp" target="_blank" rel="noopener noreferrer" class="book-link secondary">Amazon</a>
						</div>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- About Section -->
	<section class="content-section bio-section relative overflow-hidden">
		<div class="bio-section-glow" aria-hidden="true"></div>
		<div class='container px-4 mx-auto max-w-6xl relative z-10'>
			<div class="bio-shell">
				<div class="bio-portrait">
					<div class="bio-portrait-frame">
						<Image
							src={Anthony}
							alt="Anthony Townsend portrait"
							class="rounded-3xl shadow-2xl w-full"
						/>
					</div>
				</div>
				<div class="bio-content">
					<p class="eyebrow">About</p>
					<h2>Anthony M. Townsend</h2>
					<p class="bio-copy">
						Dr. Anthony Townsend is Senior Research Associate at Cornell Tech's <a href="https://urban.tech.cornell.edu/" target="_blank" rel="noopener noreferrer">Jacobs Urban Tech Hub</a>, leading multi-disciplinary collaborations that connect researchers with industry, government, and civil society partners tackling complex urban challenges.
					</p>
					<p class="bio-copy">
						Over the last 25 years he has helped shape the global conversation on cities and technology—designing smarter mobility systems, advising mayors, and mentoring startup teams building the next civic infrastructure.
					</p>
					<div class="bio-cta">
						<a href="https://urban.tech.cornell.edu/" target="_blank" rel="noopener noreferrer" class="primary">Cornell Tech</a>
						<a href="/archives" class="secondary">Consulting</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Footer with Archives Link -->
	<div class="content-section bg-white dark:bg-zinc-900" style="padding-bottom: 8rem;">
		<div class='container px-4 mx-auto max-w-6xl text-center'>
			<a href="/archives/" class="inline-block px-8 py-4 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-900 dark:text-zinc-100 font-semibold rounded-lg transition-colors text-lg">
				Looking for Star City Group? →
			</a>
		</div>
	</div>
</BaseLayout>
