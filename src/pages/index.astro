---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Prose from '../components/Prose.astro';
import { projects } from './projects/projects';
import ProjectList from '../components/ProjectList.astro'
import PostItem from '../components/PostItem.astro';
import Banner from '@src/assets/img/lisheng-chang-M2524ncJQ40-unsplash.jpg';

type BlogPost = CollectionEntry<'blog'>;

const top6Projects = projects.slice(0, 6);
const posts = (await getCollection('blog')).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION} isHomePage={true}>
	<style is:global>
		/* Target body on homepage with higher specificity */
		html body {
			padding-top: 0 !important;
		}
	</style>
	<div class="relative min-h-screen">
		<!-- Full-screen banner image with overlay -->
		<div class="absolute inset-0 z-0">
			<img 
				src={Banner.src} 
				alt="Banner" 
				class="w-full h-full object-cover"
			/>
			<div class="absolute inset-0 bg-black bg-opacity-70 dark:bg-opacity-80"></div>
		</div>
		
		<!-- Floating content over the banner image -->
		<div class="relative z-10 text-white">
			<div class='container px-6 max-w-5xl mx-auto'>
				<section class='pt-20 pb-16'>
					<div class="max-w-4xl mx-auto">
						<div class="hero-section mb-20">
							<div class="text-pretty leading-relaxed">
								<h1 class="text-5xl md:text-6xl font-bold mb-8 text-white">We make sense of urban technologies.</h1>
								<Prose>
									<div class="text-xl">
										<p class="text-gray-100 dark:text-gray-100">Rapid technological change can be terrifying.</p>
										<p class="text-gray-100 dark:text-gray-100">We work with government agencies, non-profits, and companies to make sense of emerging technologies and identify disruptions before they happen.</p>
									</div>
								</Prose>
							</div>
						</div>
					
						<div class='mb-16 backdrop-blur-sm bg-black/30 p-6 rounded-lg'>
							<div class="flex justify-between items-center border-b border-gray-600 mb-6">
								<h2 class="text-xl font-semibold">Recent Posts</h2>
								<a href="/posts/" class="inline-block text-sm underline text-gray-200 hover:opacity-75">All posts »</a>
							</div>

							<div class="space-y-5">
								{
									posts.map((post: BlogPost) => (
										<div class="flex flex-col md:flex-row md:gap-4 md:items-baseline">
											<div class="text-sm text-gray-300 min-w-28">
												{new Date(post.data.pubDate).toLocaleDateString('en-US', {
													year: 'numeric',
													month: 'short', 
													day: '2-digit'
												})}
											</div>
											<a href={`/posts/${post.slug}/`} class="text-lg font-medium text-white hover:underline">{post.data.title}</a>
										</div>
									))
								}
							</div>
						</div>

						<div class='backdrop-blur-sm bg-black/30 p-6 rounded-lg'>
							<div class="flex justify-between items-center border-b border-gray-600 mb-6">
								<h2 class="text-xl font-semibold">Projects</h2>
								<a href="/projects/" class="inline-block text-sm underline text-gray-200 hover:opacity-75">All projects »</a>
							</div>

							<div class="grid gap-6 md:grid-cols-3">
								{top6Projects.slice(0, 3).map((project) => (
									<a href={project.url} class="group">
										<div class="overflow-hidden rounded-lg shadow-lg relative">
											{project.image && (
												<>
													<div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent z-10"></div>
													<div class="absolute bottom-0 left-0 right-0 p-3 z-20">
														<span class="inline-block px-2 py-1 mb-2 text-xs rounded bg-white/20 text-white font-medium">{project.date}</span>
													</div>
													<img
														src={project.image}
														alt={project.title}
														class="h-48 w-full object-cover transition duration-300 group-hover:scale-105"
													/>
												</>
											)}
										</div>
										<h3 class="mt-2 font-medium text-white group-hover:underline">{project.name}</h3>
										<p class="text-sm text-gray-300">{project.description}</p>
									</a>
								))}
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</div>
</BaseLayout>
